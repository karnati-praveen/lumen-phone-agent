 #include <array>
 #include <functional>
 #include <float.h>
+#include <cstdio>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
+namespace {
+struct MtmdBinaryStream {
+    std::ifstream fs;
+    std::FILE* fp = nullptr;
+    bool good_flag = false;
+
+    explicit MtmdBinaryStream(const std::string& path) {
+#ifndef _WIN32
+        if (path.rfind("fd://", 0) == 0) {
+            int fd_num = std::atoi(path.c_str() + 5);
+            int dup_fd = ::dup(fd_num);
+            if (dup_fd >= 0) {
+                ::lseek(dup_fd, 0, SEEK_SET);
+                fp = ::fdopen(dup_fd, "rb");
+                if (fp) {
+                    good_flag = true;
+                } else {
+                    ::close(dup_fd);
+                }
+            }
+            return;
+        }
+#endif
+        fs.open(path, std::ios::binary);
+        good_flag = static_cast<bool>(fs);
+    }
+    ~MtmdBinaryStream() { close(); }
+    void close() {
+        if (fp) { std::fclose(fp); fp = nullptr; }
+        if (fs.is_open()) fs.close();
+    }
+    explicit operator bool() const { return good_flag; }
+    void seekg(std::size_t off, std::ios_base::seekdir dir) {
+        if (fp) {
+            int whence = (dir == std::ios::cur) ? SEEK_CUR : (dir == std::ios::end ? SEEK_END : SEEK_SET);
+            ::fseeko(fp, static_cast<off_t>(off), whence);
+        } else {
+            fs.seekg(static_cast<std::streamoff>(off), dir);
+        }
+    }
+    MtmdBinaryStream& read(char* dst, std::size_t n) {
+        if (fp) {
+            good_flag = (std::fread(dst, 1, n, fp) == n);
+        } else {
+            fs.read(dst, static_cast<std::streamsize>(n));
+            good_flag = static_cast<bool>(fs);
+        }
+        return *this;
+    }
+};
+} // namespace
 
